# Linux baseline for the Silica benchmarks: applied on top of `make tinyconfig`.
# Tuned for the same job as the Silica image: a KVM guest with a serial
# console and virtio devices, nothing loaded that the workload does not use.
# Security posture is the distribution default (mitigations on), as people run it.
CONFIG_64BIT=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_X86_X2APIC=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_NO_HZ_IDLE=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=n
CONFIG_INITRAMFS_COMPRESSION_NONE=y
CONFIG_BINFMT_ELF=y
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_ACPI=y
CONFIG_PCI=y
# Message-signalled interrupts, as every PCI Express machine uses them: the
# virtio devices interrupt per queue through MSI-X, as Silica's drivers do.
# (Missing until the block benchmarks: tinyconfig leaves it out and
# merge_config does not say so, so the baseline's disk interrupted through a
# legacy wire, and CONFIG_INTEL_IOMMU, which needs it, was dropped too.)
CONFIG_PCI_MSI=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_POSIX_TIMERS=y
CONFIG_MULTIUSER=y
CONFIG_X86_IOPL_IOPERM=y
CONFIG_DEVTMPFS=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_CPU_MITIGATIONS=y
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_BLOCK=y
CONFIG_VIRTIO_BLK=y
# Direct block reads at depth (the block benchmarks): io_uring.
CONFIG_IO_URING=y
# DMA confined by the IOMMU where the machine has one (the *_confined block
# benchmarks), in Linux's fastest mode for it: lazy invalidation through a
# flush queue (a freed buffer stays reachable by the device for a while,
# which Silica's Unmap never allows). On a machine without an IOMMU none of
# this does anything.
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y
CONFIG_IOMMU_DEFAULT_DMA_LAZY=y
CONFIG_CMDLINE_BOOL=y
# Idle polling for a guest (cpuidle-haltpoll): an idle processor watches for
# work before it halts, as Silica's does (IDLE_WATCH_NS), so that a wake-up
# across processors does not leave the virtual machine. Forced on, as on a
# guest tuned for latency; the poll time is Linux's own (adaptive, up to
# guest_halt_poll_ns = 200 us).
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_HALTPOLL=y
CONFIG_HALTPOLL_CPUIDLE=y
CONFIG_CMDLINE="console=ttyS0,115200 quiet panic=-1 tsc=reliable cpuidle_haltpoll.force=1 intel_iommu=on"
